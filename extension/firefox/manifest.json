{
  "manifest_version": 3,
  "name": "Parabolic Download Manager",
  "version": "0.4.2",
  "description": "Download video and audio from web players with the Parabolic desktop application.",
  "author": "NickvisionApps, OwlRoyalty & Othman Benbrahim",
  "homepage_url": "https://github.com/Othman-Benbrahim/Parabolic",
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "parabolic-media-detector@othmanbenbrahim.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  },
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "webRequest",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["utils.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["media-detector.js", "media-overlay.js"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Parabolic downloads and diagnostics",
    "default_popup": "popup.html",
    "default_icon": {
      "38": "icons/icon38.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "38": "icons/icon38.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-parabolic-current-tab": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Opens current tab in Parabolic."
    },
    "open-parabolic-options": {
      "suggested_key": {
        "default": "Alt+O",
        "mac": "Alt+O"
      },
      "description": "Opens Parabolic Options page."
    }
  }
}
